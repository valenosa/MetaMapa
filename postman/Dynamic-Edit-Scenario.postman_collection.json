{
	"info": {
		"name": "Dynamic source: edit scenario",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"description": "End-to-end moderation scenario for the dynamic source, with assertions. Run it with the Collection Runner or Newman on a fresh dynamic-source database (it uses the ids 1 to 3): creates three events, accepts two submissions and rejects one, requests edits and approves two edit requests. X-User-Id simulates the header injected by the gateway."
	},
	"item": [
		{
			"name": "Create Event 1",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "X-User-Id",
						"value": "{{testUserId}}",
						"type": "text"
					}
				],
				"body": {
					"mode": "formdata",
					"formdata": [
						{
							"key": "event",
							"value": "{\n  \"title\": \"Vertido químico en el río\",\n  \"description\": \"Se observó espuma blanca en la orilla del río en la zona norte.\",\n  \"category\": \"CONTAMINACION\",\n  \"latitude\": -34.620101,\n  \"longitude\": -58.410087,\n  \"eventDate\": \"2025-05-12\"\n}",
							"type": "text",
							"contentType": "application/json"
						}
					]
				},
				"url": {
					"raw": "{{dynamic-source-baseUrl}}/events",
					"host": [
						"{{dynamic-source-baseUrl}}"
					],
					"path": [
						"events"
					]
				}
			},
			"response": [],
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Create Event 1: submitted (200)\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"The created event is returned\", function () {",
							"    pm.expect(pm.response.json().id).to.be.a(\"number\");",
							"});"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			]
		},
