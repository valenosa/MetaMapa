# --- Server ---
server.port=8083

# --- Scheduled CSV import (every minute) ---
import.csv.cron=0 * * * * *

# Folder for uploaded CSV files, relative to the home directory of the user running the service
static-source.storage.dir=metamapa/static-sources/csv
# Maximum upload size (keep it in line with the web client setting)
spring.servlet.multipart.max-file-size=50MB

# --- Eureka client ---
spring.application.name=static-source
eureka.client.service-url.defaultZone=http://localhost:8761/eureka/
eureka.client.enabled=true

# --- Database ---
spring.datasource.url=jdbc:mysql://localhost:3306/metamapa_static?useSSL=false&serverTimezone=UTC&createDatabaseIfNotExist=true
spring.datasource.username=<DB_USERNAME>
spring.datasource.password=<DB_PASSWORD>
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# --- Hibernate ---
# Possible values: validate | update | create | create-drop | none
spring.jpa.hibernate.ddl-auto=create-drop
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQL8Dialect
