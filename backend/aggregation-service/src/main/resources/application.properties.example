# --- Server ---
server.port=8080

# --- Scheduled jobs ---
# Collection refresh (every hour)
collection.refresh.cron=0 0 * * * *
# Consensus re-evaluation (every day at 3 AM)
reevaluate.consensus.cron=0 0 3 * * *
statistics.refresh.cron=0 0 * * * *

# Public URL of this service, sent to the sources as the callback for push notifications
aggregation-service.url=http://localhost:8080

# --- Location normalization (GeoRef API) ---
geo-ref.url=https://apis.datos.gob.ar/georef/api
# Parallel requests to GeoRef and coordinates per request (GeoRef accepts up to 1000)
thread.count=4
batch.size=1000
# Maximum response size accepted from GeoRef, in bytes
response.byte.size=1048576

# --- Media URL generation (media is served through the API Gateway) ---
api.gateway.url=http://localhost:8086
multimedia.path=/api/v1/multimedia

# --- Eureka client ---
spring.application.name=aggregation-service
eureka.client.service-url.defaultZone=http://localhost:8761/eureka/
eureka.client.enabled=true

# --- Database ---
spring.datasource.url=jdbc:mysql://localhost:3306/metamapa_aggregator?useSSL=false&serverTimezone=UTC&createDatabaseIfNotExist=true
spring.datasource.username=<DB_USERNAME>
spring.datasource.password=<DB_PASSWORD>
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# --- Hibernate ---
# Possible values: validate | update | create | create-drop | none
# create-drop recreates the tables on every start and drops them on shutdown; use update to keep data.
spring.jpa.hibernate.ddl-auto=create-drop
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQL8Dialect
