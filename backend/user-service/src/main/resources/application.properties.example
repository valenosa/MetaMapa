# --- Server ---
server.port=8087

# --- Eureka client ---
spring.application.name=user-service
eureka.client.service-url.defaultZone=http://localhost:8761/eureka/
eureka.instance.prefer-ip-address=true
eureka.client.enabled=true

# --- Database ---
spring.datasource.url=jdbc:mysql://localhost:3306/metamapa_users?useSSL=false&serverTimezone=UTC&createDatabaseIfNotExist=true
spring.datasource.username=<DB_USERNAME>
spring.datasource.password=<DB_PASSWORD>
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# --- Hibernate ---
# Possible values: validate | update | create | create-drop | none
# update creates the tables on the first run and keeps the accounts between restarts.
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQL8Dialect

# --- JWT (RS256) ---
# Base64-encoded keys without PEM headers: PKCS#8 private key, X.509 public key (see docs/running-locally.md).
# The JWT_PRIVATE_KEY and JWT_PUBLIC_KEY environment variables take precedence over the values after the colon.
# Never commit real keys.
app.jwt.private-key=${JWT_PRIVATE_KEY:<JWT_PRIVATE_KEY>}
app.jwt.public-key=${JWT_PUBLIC_KEY:<JWT_PUBLIC_KEY>}
# Access tokens are short-lived; refresh tokens last one day.
app.jwt.expiration-minutes=5
app.jwt.refresh-expiration-minutes=1440
