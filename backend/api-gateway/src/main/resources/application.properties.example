# --- Server ---
server.port=8086

# --- Routes (paths, target services and authentication rules) ---
spring.config.import=classpath:routes.yml

# --- Eureka client ---
spring.application.name=api-gateway
eureka.client.service-url.defaultZone=http://localhost:8761/eureka/

# --- JWT (RS256) ---
# Public key only: the gateway verifies tokens, it never issues them.
# Base64-encoded X.509 key without PEM headers (see docs/running-locally.md).
# The JWT_PUBLIC_KEY environment variable takes precedence over the value after the colon.
app.jwt.public-key=${JWT_PUBLIC_KEY:<JWT_PUBLIC_KEY>}
