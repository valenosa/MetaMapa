# --- Server ---
server.port=8081

# --- File uploads ---
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=50MB
# Maximum number of files per event
app.event.max-files=5

# --- Media URL generation (media is served through the API Gateway) ---
api.gateway.url=http://localhost:8086
multimedia.path=/api/v1/multimedia

# --- Eureka client ---
spring.application.name=dynamic-source
eureka.client.service-url.defaultZone=http://localhost:8761/eureka/
eureka.client.enabled=true

# --- Allowed MIME types for uploads (whitelist) ---
# Entries must be valid MIME types or the service refuses to start. A misspelled but well-formed type
# (for example image/jprg) is accepted silently, so if uploads of some type fail, check this list first.
app.event.allowed-mime-types=audio/mpeg,image/png,image/jpg,image/gif,image/jpeg,image/webp,video/mp4,video/quicktime

# --- Database ---
spring.datasource.url=jdbc:mysql://localhost:3306/metamapa_dynamic?useSSL=false&serverTimezone=UTC&createDatabaseIfNotExist=true
spring.datasource.username=<DB_USERNAME>
spring.datasource.password=<DB_PASSWORD>
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# --- Hibernate ---
# Possible values: validate | update | create | create-drop | none
spring.jpa.hibernate.ddl-auto=create-drop
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQL8Dialect

# --- Object storage (any S3-compatible service; MinIO in development) ---
aws.s3.endpoint=http://localhost:9000
# MinIO ignores the region, but the AWS SDK requires one; use the real region with a cloud provider.
aws.s3.region=us-east-1
aws.s3.access-key=<MINIO_ACCESS_KEY>
aws.s3.secret-key=<MINIO_SECRET_KEY>
# The bucket must exist before the first upload.
aws.s3.bucket-name=metamapa-media
# MinIO needs path-style URLs (http://host/bucket). AWS uses virtual-hosted style, so set this to false there if needed.
aws.s3.path-style-access=true
